# Copy to /home/pi/household/.env on the Pi and chmod 600. Never commit the real file.

# Google OAuth client (Web application) from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public name Tailscale Funnel printed, e.g. https://raspberrypi.tail1234.ts.net
BASE_URL=

# The only two Google accounts allowed to call the server, comma-separated
ALLOWED_EMAILS=owner@example.com,partner@example.com

# Store and bind
STORE_DIR=/home/pi/household
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Optional: names used in the attribution stamp, else the part of the email before the first dot
# STAMP_NAMES=owner@example.com=rob,partner@example.com=partner

# Local development only. The server refuses to start if this is set and BASE_URL is not localhost.
# DEV_BYPASS=

# Phase 2: Google Keep mirror (unofficial gkeepapi, master-token login).
# scripts/keep_login.py (run on the laptop) fills KEEP_USERNAME and KEEP_MASTER_TOKEN; never paste the token by hand.
KEEP_USERNAME=
KEEP_MASTER_TOKEN=
# Exact titles of the lists in Keep (no quotes)
KEEP_SHOPPING_LIST=Grocery List
KEEP_NOTES_LIST=House notes

# Synology NAS: File Station API for nas_backup.py and the SMB host for the scripts
NAS_URL=http://192.0.2.10:5000
NAS_HOST=192.0.2.10

# Phase 4: voice assistant on the ReSpeaker XVF3800 (household-voice.service). Not started until enabled.
# Brain: with no ANTHROPIC_API_KEY the daemon uses Claude Code's headless mode on the owner's subscription
# (claude logged in as pi on the Pi, store attached via voice/mcp.json). An API key switches to the API.
ANTHROPIC_API_KEY=
# Model for the Claude Code brain, e.g. sonnet for speed; empty means Claude Code's default
VOICE_CC_MODEL=
# Substring of the ALSA device name to use for both capture and playback
VOICE_DEVICE=XVF3800
VOICE_WAKE_MODEL=/home/pi/voice-models/hey_claude.onnx
# Lower toward 0.3 if it misses you, raise if it wakes on its own
VOICE_WAKE_THRESHOLD=0.5
# faster-whisper model: base.en is quick, small.en is more accurate but slower on a Pi 4
VOICE_WHISPER_MODEL=base.en
VOICE_PIPER_VOICE=/home/pi/voice-models/en_US-lessac-medium.onnx
VOICE_MODEL=claude-opus-5-5
# Name used in the attribution stamp for things said at the speaker
VOICE_USER=voice
# Seconds to keep listening for a follow-up after each reply
VOICE_FOLLOW_UP_SECONDS=6
# Hosted speech (recommended on a Pi 4: local whisper and Piper run at real time, too slow to talk to).
# With a Deepgram key set, recognition and speech go to Deepgram; the wake word stays local.
DEEPGRAM_API_KEY=
VOICE_DEEPGRAM_STT=nova-3
VOICE_DEEPGRAM_TTS=aura-2-thalia-en
# Where replies are played: respeaker (speaker on the array, interruptible) or cast:<Google device name>
# e.g. cast:Kitchen display. Casting adds 2-3 s per reply and the daemon cannot listen while it talks.
VOICE_OUTPUT=respeaker
# Which USB capture channel of the ReSpeaker to listen on. Measured 2026-10-22: with Seeed's
# firmware, channel 1 scores the wake word 3-10x higher than channel 0 from across the room.
VOICE_CHANNEL=1
# VOICE_DIAG=1 logs wake scores above 0.1 on both channels, for tuning
