# Copy to /home/pi/household/.env on the Pi and chmod 600. Never commit the real file.

# Google OAuth client (Web application) from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public name Tailscale Funnel printed, e.g. https://raspberrypi.tail1234.ts.net
BASE_URL=

# The only two Google accounts allowed to call the server, comma-separated
ALLOWED_EMAILS=owner@example.com,partner@example.com

# Store and bind
STORE_DIR=/home/pi/household
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Optional: names used in the attribution stamp, else the part of the email before the first dot
# STAMP_NAMES=owner@example.com=rob,partner@example.com=partner

# Local development only. The server refuses to start if this is set and BASE_URL is not localhost.
# DEV_BYPASS=

# Phase 2: Google Keep mirror (unofficial gkeepapi, master-token login).
# scripts/keep_login.py (run on the laptop) fills KEEP_USERNAME and KEEP_MASTER_TOKEN; never paste the token by hand.
KEEP_USERNAME=
KEEP_MASTER_TOKEN=
# Exact titles of the lists in Keep (no quotes)
KEEP_SHOPPING_LIST=Grocery List
KEEP_NOTES_LIST=House notes
